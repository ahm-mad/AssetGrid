# Supabase — from your project's Settings → API / Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_SECRET=

# Direct connection is IPv6-only on most hosts — use the session pooler
# (Settings → Database → Connection pooling) for migrations/scripts.
SUPABASE_DATABASE_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_DB_URL_POOLER=postgresql://postgres.your-project-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL_TX_POOLER=postgresql://postgres.your-project-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (test mode) — from the Stripe Dashboard
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Shared secret gating /api/internal/* scheduled routes — generate with
# `openssl rand -hex 32`; must match private.app_config.internal_function_secret
INTERNAL_FUNCTION_SECRET=

# --- Optional — every one of these gates gracefully to a mocked/no-op path
# when unset, so the app builds and runs without them.
RESEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WEBHOOK_URL=
LNS_DOWNLINK_HOST=
LNS_DOWNLINK_TOKEN=
SENSOR_WEBHOOK_HMAC_SECRET=
CONTRACT_SIGN_SECRET=
